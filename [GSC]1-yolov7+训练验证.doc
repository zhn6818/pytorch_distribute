=8B(run_pytorch1.9.sh)</li>=20
</ul>=20
<pre><code>#!/bin/bash

ver=3Dv1.14.0
export MY_CONTAINER=3D"mlu370_pytorch_ubuntu18.04_torch1.9_guoshoucai_${ver=
}_`whoami`"
export IMAGE_NAME=3D"yellow.hub.cambricon.com/pytorch/pytorch:${ver}-torch1=
.9-ubuntu18.04-py37"

num=3D`docker ps -a|grep -w "$MY_CONTAINER$"|wc -l`
echo $num
echo $MY_CONTAINER
echo $IMAGE_NAME

if [ 0 -eq $num ];then
=09xhost +
=09docker run \
=09=09-e DISPLAY=3Dunix$DISPLAY \
=09=09--net=3Dhost \
=09=09--shm-size '64gb' \
=09=09-it --privileged \
=09=09--name $MY_CONTAINER \
=09=09-v /data/:/data/ \
=09=09-v /opt/share/datasets/:/datasets/\
=09=09-v /opt/share/models/:/models/\
=09=09-v $PWD/:/workspace/ \
=09=09-w /workspace/\
=09=09-v /usr/bin/cnmon:/usr/bin/cnmon \
=09=09$IMAGE_NAME \
=09=09/bin/bash
else
=09docker start $MY_CONTAINER
=09docker exec -ti $MY_CONTAINER /bin/bash
fi
</code></pre>=20
